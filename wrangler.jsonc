{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kpit",
	// Mrfansi account; pins deploys/remote commands so they never hit another account.
	"account_id": "9eff0ff52ac1e3b3c6d955c9fe3a8ad0",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		// Self-reference required by OpenNext; must match "name".
		{ "binding": "WORKER_SELF_REFERENCE", "service": "kpit" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kpit",
			"database_id": "52360490-904e-4c4d-9fe0-a2536628f154",
			// Same SQL files Drizzle generates; wrangler tracks them in its own d1_migrations table.
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		// Comment image uploads (previously public/uploads/comments on disk).
		{ "binding": "UPLOADS", "bucket_name": "kpit-uploads" }
	],
	// Canonical origin; must match the AUTH_URL secret.
	"routes": [{ "pattern": "kpit.mrfansi.dev", "custom_domain": true }],
	"observability": { "enabled": true },
	// Keep plaintext vars set in the Cloudflare dashboard on `wrangler deploy` (secrets are always kept).
	"keep_vars": true
}
