# Required: Random secret for NextAuth.js session encryption (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-random-secret-here

# Initial admin user credentials for seed script (npm run seed:admin)
# IMPORTANT: Set strong values before running seed:admin
# Generate password: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: Webhook URL for red KPI notifications (supports Slack/Discord/custom)
# Leave empty to disable notifications
NOTIFY_WEBHOOK_URL=

# Optional: Cloudflare Workers AI, dipakai semua fitur AI (chat, ringkasan
# domain, narasi executive report, analisis KPI, risiko timeline).
# Keduanya wajib diisi bersama — kalau salah satu kosong, fitur AI mati.
# Account ID: dashboard Cloudflare > Workers & Pages > Overview (kanan)
# API Token: My Profile > API Tokens, butuh izin "Workers AI: Read"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: menimpa model default (@cf/openai/gpt-oss-120b).
# Model kecil seperti @cf/meta/llama-3.1-8b-instruct jauh lebih murah tapi
# sering menjawab dalam bahasa Inggris meski diminta Bahasa Indonesia.
# Daftar model: https://developers.cloudflare.com/workers-ai/models/
CLOUDFLARE_AI_MODEL=
