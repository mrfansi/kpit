# Required: Random secret for better-auth session signing (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-random-secret-here

# Required in production: canonical public origin (https://your-host). Also used
# for the monthly report origin check.
AUTH_URL=http://localhost:3000

# Initial admin user credentials for seed script (npm run seed:admin)
# IMPORTANT: Set strong values before running seed:admin
# Generate password: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: DeepSeek API, dipakai semua fitur AI (chat, ringkasan domain, narasi
# executive report, analisis KPI, risiko timeline). Kosong = fitur AI mati.
# API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: menimpa model default (deepseek-flash), mis. deepseek-v4-pro.
# Daftar model: https://api-docs.deepseek.com/quick_start/pricing
DEEPSEEK_MODEL=
