# Supply-chain guard (carried over from pnpm's minimumReleaseAge): only install
# versions published at least 1 day ago, except these deliberately pinned fresh releases.
min-release-age=1
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=eslint-config-next
min-release-age-exclude[]=wrangler
min-release-age-exclude[]=miniflare
min-release-age-exclude[]=shadcn
min-release-age-exclude[]=@shadcn/registry
