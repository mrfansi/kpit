{
  "name": "kpit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "test": "node --import ./src/testing/register.ts --import tsx --test",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "preview": "vite build && vite preview",
    "deploy": "vinext-cloudflare deploy",
    "d1:migrate:local": "cf d1 migrations apply 52360490-904e-4c4d-9fe0-a2536628f154 --dir drizzle --local --persist-to .cloudflare/state",
    "d1:migrate:remote": "cf d1 migrations apply 52360490-904e-4c4d-9fe0-a2536628f154 --dir drizzle",
    "d1:export": "tsx src/scripts/export-to-d1.ts export",
    "d1:import": "tsx src/scripts/export-to-d1.ts import",
    "d1:verify": "tsx src/scripts/export-to-d1.ts verify",
    "cf-typegen": "cf workers types"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@vinext/cloudflare": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.576.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.71.2",
    "react-server-dom-webpack": "^19.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vinext": "^1.4.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "better-sqlite3": "^13.0.3",
    "cf": "^1.0.0-beta.28",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.21.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "workerd": true
  },
  "type": "module"
}
